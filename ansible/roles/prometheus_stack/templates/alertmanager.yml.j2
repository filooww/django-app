# Managed by Ansible
route:
  receiver: {{ 'telegram' if prometheus_stack_telegram_bot_token | length > 0 else 'ui-only' }}
  # One notification per alert name and server instead of one per time series
  group_by: [alertname, instance]
  group_wait: 30s       # wait for related alerts before the first notification
  group_interval: 5m    # new alerts in an existing group
  repeat_interval: 4h   # remind about alerts that are still firing
  routes:
    - matchers: [severity = "critical"]
      repeat_interval: 1h

inhibit_rules:
  # A server that cannot be scraped produces no useful warnings: show only TargetDown
  - source_matchers: [alertname = "TargetDown"]
    target_matchers: [severity = "warning"]
    equal: [instance]
  # Critical disk alert replaces the warning for the same filesystem
  - source_matchers: [alertname = "DiskSpaceCritical"]
    target_matchers: [alertname = "LowDiskSpace"]
    equal: [instance, mountpoint]

receivers:
  - name: ui-only
{% if prometheus_stack_telegram_bot_token | length > 0 %}
  - name: telegram
    telegram_configs:
      - bot_token_file: /etc/alertmanager/telegram_token
        chat_id: {{ prometheus_stack_telegram_chat_id | int }}
        parse_mode: HTML
        send_resolved: true
        message: |-
{% raw %}          {{ if eq .Status "firing" }}🔥{{ else }}✅{{ end }} <b>{{ .Status | toUpper }}</b> {{ .CommonLabels.alertname }} · {{ .CommonLabels.severity }}
          {{ range .Alerts }}
          <b>{{ .Annotations.summary }}</b>
          {{ .Annotations.description }}
          {{ end }}{% endraw %}

{% endif %}
